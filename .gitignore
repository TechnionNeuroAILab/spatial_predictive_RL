# Ignore directories named data/, except the top-level dataset folder.
data/
!/data/

*.pkl
*.parquet
!results/tables/*.parquet
*.npy
*.pt
checkpoints/
**/checkpoints/
Papers/
__pycache__/
*.pyc
.ipynb_checkpoints/
New_Results_v2/**/data/
New_Results_v2/**/checkpoints/

# --- run-output trees (regenerable, see code/README.md) ---
# *.pkl / *.parquet / *.pt / checkpoints/ above already exclude the bulk
# (raw activity/weights). These add the per-run diagnostic PNGs each training
# script dumps automatically -- NOT the assembled paper figures, which live
# under code/figures/*/figures{,_supp}/ and stay tracked.
results/**/*.png
New_Results/**/*.png
New_Results_v2/**/*.png
New_Results_v3/**/*.png
old_code/**/*.png
Results/**/*.png

# Legacy trees. results/ stays tracked (run metadata only).
# Top-level data/ is tracked except the Sosa NWB recordings.
/New_Results/
/New_Results_v2/
/New_Results_v3/
/Results/
/old_code/
/Analysis_Plots/
/sandbox/
/data/sosa2025/nwb/

# paper_repo/ is a separately Overleaf-synced git repo (its own remote/history,
# see README) -- not tracked inside this repo.
/paper_repo/
# regenerate_all.py per-figure run logs (transient; warnings + progress)
code/figures/_logs/

# --- code-review scratch output (not part of the paper) ---
# Reconstruction/diagnostic figures written by the code review. The write-up
# itself (code/code_review.md) stays tracked; these are regenerable and
# must not be mistaken for assembled paper figures.
code/code_review_figures/

# macOS finder metadata
.DS_Store
**/.DS_Store
